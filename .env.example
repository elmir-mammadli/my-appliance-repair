GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_TAB=Service Requests
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
NOTIFICATION_EMAIL=your@email.com
# Server-side key with Places API (New) enabled; never use a NEXT_PUBLIC_ variable.
GOOGLE_PLACES_API_KEY=your_google_places_api_key
# Cloudflare Turnstile (captcha). Get both keys at dash.cloudflare.com > Turnstile.
# Required in production (forms are rejected without them). Optional in local dev.
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
